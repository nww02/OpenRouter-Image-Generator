<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaCheckDiagnosticsConflict>false</AvaloniaCheckDiagnosticsConflict>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <!-- MVVM Toolkit for clean ViewModel pattern -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <!-- MDI Docking library for managed windows (Dock 12.1.5 requires Avalonia >= 12.1.5) -->
        <PackageReference Include="Dock.Avalonia" Version="12.1.5" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.5" />
        <PackageReference Include="Dock.Model" Version="12.1.5" />
        <PackageReference Include="Dock.Model.Mvvm" Version="12.1.5" />
    </ItemGroup>
</Project>
