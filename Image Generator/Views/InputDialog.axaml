<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Image_Generator.Views.InputDialog"
        Title="Input"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" MinHeight="30" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK" Click="OnOkClick" MinWidth="80" />
            <Button Content="Cancel" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>